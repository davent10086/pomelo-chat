# pomelo-chat 前端环境变量配置
# 复制本文件为 .env 并按需调整（.env 不要提交到仓库）

# ---- 后端服务端口 ----
# 用于拼接 API/WebSocket 基址（与当前页面主机组合）
VITE_SERVER_PORT=3000

# ---- AES-GCM 加密密钥 ----
# 16 或 32 字节字符串，用于消息加密
# 注意：前端密钥可被提取，机密性应依赖 HTTPS，此处仅做语义安全
VITE_ENCRYPT_KEY=a2b7e151628aed2a6abf7158809cf4f3

# ---- AI 助手头像路径 ----
# 相对站点根目录的路径，便于替换 AI 角色形象
VITE_AI_AVATAR_PATH=/Tomotake Yoshino.jpg

# ---- 可选：显式指定后端地址 ----
# 不填则按当前页面主机 + VITE_SERVER_PORT 自动拼接
# VITE_API_BASE=http://localhost:3000/api/chat/v1
# VITE_WS_BASE=ws://localhost:3000/api/chat/v1
# VITE_SERVER_URL=http://localhost:3000

# ---- AI 助手 ----
# H4: DeepSeek API Key 已移至后端，前端不再需要配置
# AI 助手通过 /api/chat/v1/assistant 代理调用，密钥由服务端管理
