{
  "name": "pomelo-chat",
  "version": "1.0.0",
  "description": "pomelo-chat项目",
  "license": "ISC",
  "author": "davent lee",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test:full:server": "node tests/run.cjs server",
    "test:full:browser": "node tests/run.cjs e2e",
    "start": "pnpm --filter pomelo-chat-server start",
    "dev:client": "pnpm --filter pomelo-chat-client dev",
    "dev:server": "pnpm --filter pomelo-chat-server start",
    "dev:desktop": "pnpm --filter pomelo-chat-desktop dev",
    "test:desktop": "node tests/run.cjs desktop",
    "test:desktop:smoke": "node tests/run.cjs desktop-smoke",
    "build:desktop": "pnpm --filter pomelo-chat-client exec tsc && pnpm --filter pomelo-chat-desktop dist",
    "test:desktop:production": "node tests/run.cjs desktop-production",
    "test:unit": "node tests/run.cjs unit",
    "test:database": "node tests/run.cjs integration --filter database/",
    "test:api": "node tests/run.cjs integration --filter http/",
    "test:integration": "node tests/run.cjs integration",
    "test:security": "node tests/run.cjs security",
    "test:qa": "node tests/run.cjs qa",
    "test:coverage": "node tests/run.cjs coverage",
    "test": "pnpm run test:unit",
    "test:all": "node tests/run.cjs ci",
    "test:ci": "node tests/run.cjs ci",
    "test:checks": "node tests/run.cjs checks",
    "test:list": "node tests/run.cjs list",
    "test:rtc": "node tests/run.cjs rtc",
    "test:performance": "node tests/run.cjs performance",
    "test:ai-live": "node tests/run.cjs ai-live",
    "build": "pnpm --filter pomelo-chat-server build && pnpm --filter pomelo-chat-client build",
    "lint": "pnpm --filter pomelo-chat-server lint && pnpm --filter pomelo-chat-client lint",
    "lint:fix": "pnpm --filter pomelo-chat-server lint:fix && pnpm --filter pomelo-chat-client lint:fix",
    "prettier": "pnpm --filter pomelo-chat-server prettier && pnpm --filter pomelo-chat-client prettier",
    "test:system": "node tests/run.cjs integration --filter system-integrity",
    "test:e2e": "node tests/run.cjs e2e",
    "test:real-chat": "node tests/run.cjs e2e --filter real-chat",
    "test:real-rtc": "node tests/run.cjs rtc"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
