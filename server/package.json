{
  "name": "pomelo-chat-server",
  "private": true,
  "version": "1.0.0",
  "description": "pomelo-chat 项目的后端部分",
  "main": "dist/index.js",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "author": {
    "name": "daventLee"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:pull": "prisma db pull",
    "test:prisma": "node ../tests/run.cjs integration --filter database/prisma",
    "start": "nodemon --watch src --ext ts --exec \"ts-node --files src/index.ts\"",
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime-assets.js",
    "serve": "node dist/index.js",
    "db:migrate": "ts-node --files src/model/migrate.ts",
    "test:db-migrations": "node ../tests/run.cjs integration --filter migrations.test.cjs",
    "test:report-regressions": "node ../tests/run.cjs integration --filter reported-defects.test.cjs",
    "test:production-smoke": "node ../tests/run.cjs integration --filter production-smoke.test.cjs",
    "outbox:retry": "node scripts/requeue-outbox.js",
    "test:architecture": "node ../tests/run.cjs checks --filter architecture.check.cjs",
    "test:backend": "node ../tests/run.cjs integration --filter backend-reliability.test.cjs",
    "test:http-errors": "node ../tests/run.cjs integration --filter errors.test.cjs",
    "test:p2-regressions": "node ../tests/run.cjs unit --filter transaction-lifecycle.test.cjs",
    "seed:anime-demo": "ts-node --files scripts/seed-anime-demo.ts",
    "test:agent": "node ../tests/run.cjs ai-live",
    "test:agent-routing": "node ../tests/run.cjs unit --filter agent-routing.test.cjs",
    "test:agent-stream": "node ../tests/run.cjs unit --filter agent-stream.test.cjs",
    "test:agent-read-tools": "node ../tests/run.cjs integration --filter read-tools.test.cjs",
    "test:agent-actions": "node ../tests/run.cjs integration --filter actions.test.cjs",
    "test:security": "node ../tests/run.cjs unit --filter security-boundaries.test.cjs",
    "test:message-protocol": "node ../tests/run.cjs checks --filter message-protocol.check.cjs",
    "test:mcp": "node ../tests/run.cjs integration --filter mcp-stdio.test.cjs",
    "test:tool-contracts": "node ../tests/run.cjs integration --filter tool-contracts.test.cjs",
    "test:mcp-policy": "node ../tests/run.cjs unit --filter mcp-policy.test.cjs",
    "mcp:stdio": "ts-node --files src/mcp/pomelo-stdio.ts",
    "lint": "eslint . --ext .ts --max-warnings=0",
    "lint:fix": "eslint . --ext .ts --max-warnings=0 --fix",
    "prettier": "prettier --write \"src/**/*.ts\"",
    "test:system": "node ../tests/run.cjs integration --filter system-integrity.test.cjs",
    "test:message-overload": "node ../tests/run.cjs integration --filter overload.test.cjs"
  },
  "dependencies": {
    "@langchain/core": "^1.2.3",
    "@langchain/openai": "^1.5.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@modelcontextprotocol/server": "^2.0.0-beta.4",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-ws": "^5.0.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.0",
    "langchain": "^1.5.3",
    "livekit-server-sdk": "^2.19.0",
    "multer": "1.4.5-lts.1",
    "mysql2": "^3.24.5",
    "ws": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^4.17.21",
    "@types/express-ws": "^3.0.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.30",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "eslint": "^8.57.1",
    "lint-staged": "^15.2.2",
    "nodemon": "^3.1.7",
    "prettier": "^3.2.5",
    "prisma": "7.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "lint-staged": {
    "**/*.ts": [
      "pnpm run lint:fix"
    ]
  }
}
