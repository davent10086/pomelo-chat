# External MCP servers are optional. Keep this JSON on the server only.
# Each server must be explicitly configured; no external process is started by default.
# The command runs with the server process account, so use a dedicated working directory
# and allow-list tools wherever possible.
MCP_SERVERS_JSON=[{"name":"web-search","category":"web","command":"npx","args":["-y","@modelcontextprotocol/server-brave-search"],"env":{"BRAVE_API_KEY":"replace-me"},"allowedTools":["brave_web_search"]}]

# Example local files MCP. Replace the path with a narrow, non-sensitive directory.
# MCP_SERVERS_JSON=[{"name":"files","category":"files","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","C:\\path\\to\\shared-files"],"allowedTools":["read_file","list_directory","search_files"]}]

# Calendar example: expose read/list tools normally. Put create/update tools in writeTools.
# They can only be executed through the authenticated agent tool endpoint with confirmation.
# MCP_SERVERS_JSON=[{"name":"calendar","category":"calendar","command":"your-calendar-mcp-command","args":[],"env":{"CALENDAR_TOKEN":"replace-me"},"allowedTools":["list_events","search_events"],"writeTools":["create_event","update_event"]}]

# For cloud drives, configure a provider MCP server and expose only search/read tools.
# Do not put secrets in git.

# Alibaba Cloud Model Studio (Bailian) WebSearch MCP.
# Enable the WebSearch service in the Bailian MCP marketplace first, then set
# DASHSCOPE_API_KEY in server/.env. The ${...} placeholder is expanded at runtime.
# MCP_SERVERS_JSON=[{"name":"aliyun-web-search","category":"web","type":"streamableHttp","url":"https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp","headers":{"Authorization":"Bearer ${DASHSCOPE_API_KEY}"}}]

# Bailian WebParser usually uses a workspace-specific URL. Copy the URL shown
# in Bailian MCP external-call configuration and replace the placeholder below.
# MCP_SERVERS_JSON=[{"name":"aliyun-web-parser","category":"web","type":"streamableHttp","url":"https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1/mcps/WebParser/mcp","headers":{"Authorization":"Bearer ${DASHSCOPE_API_KEY}"}}]

# Alibaba Cloud Model Studio Amap Maps MCP.
# It exposes route planning, geocoding, POI search, weather and distance tools.
# MCP_SERVERS_JSON=[{"name":"amap-maps","category":"other","type":"streamableHttp","url":"https://dashscope.aliyuncs.com/api/v1/mcps/amap-maps/mcp","headers":{"Authorization":"Bearer ${DASHSCOPE_API_KEY}"}}]
