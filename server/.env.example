# pomelo-chat 服务端环境变量配置
# 复制本文件为 .env 并填写真实值（.env 不要提交到仓库）

# ---- JWT ----
# JWT 签名密钥（必填，建议使用随机长字符串）
JWT_SECRET=your-super-secret-jwt-key-change-me

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pomelo-chat

# ---- Redis ----
# ioredis 默认连接 127.0.0.1:6379，如需自定义请设置 REDIS_URL
# REDIS_URL=redis://127.0.0.1:6379

# ---- CORS ----
# 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- AI 助手（千问，阿里云百炼北京地域）----
# 仅在服务端配置；其他地域使用对应的兼容接口地址和密钥
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
# 兼容旧 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL，AI_* 优先

# ---- 服务端口 ----
PORT=3000

# ---- Go 网关 / Outbox（根目录 pnpm start / pnpm dev:server 默认启用）----
# Node 业务监听 3001，Go 对外监听 3000；回退时两个 DRIVER 都设置 node。
REALTIME_DRIVER=go
OUTBOX_DRIVER=go
NODE_PORT=3001
# 以下两项留空由根启动器按端口计算，独立部署时显式设置。
# NODE_INTERNAL_URL=http://127.0.0.1:3001
# GO_REALTIME_ADDR=:3000
# 生产必填，至少 32 字符；本地 --dev 留空时仅为本次启动生成，不写入文件。
REALTIME_INTERNAL_TOKEN=
# 分别部署时使用独立监听地址，执行 pomelo-realtime -role gateway 或 -role worker。
OUTBOX_CONCURRENCY=8
OUTBOX_LEASE_SECONDS=60
OUTBOX_POLL_MS=2000
GO_SOCKET_QUEUE=128
GO_ROOM_QUEUE=256
GO_MAX_CONNECTIONS=20000

# ---- 消息入口保护：平均每秒额度 / 短突发容量 ----
MESSAGE_USER_RATE=5
MESSAGE_USER_BURST=10
MESSAGE_PRIVATE_RATE=10
MESSAGE_PRIVATE_BURST=20
MESSAGE_GROUP_RATE=20
MESSAGE_GROUP_BURST=20
MESSAGE_GLOBAL_RATE=150
MESSAGE_GLOBAL_BURST=100

# 单进程排队上限（包含执行中的任务）
MESSAGE_ROOM_QUEUE_MAX=32
MESSAGE_WRITE_QUEUE_MAX=256
# Outbox 每两秒采样一次；保护阈值为软门槛，并非数据库硬容量
MESSAGE_OUTBOX_MAX_PENDING=500
MESSAGE_OUTBOX_ROOM_MAX_PENDING=40
MESSAGE_OUTBOX_MAX_AGE_SECONDS=3

# 留空关闭指标访问；启用后 /internal/metrics 要求 Authorization: Bearer <token>
METRICS_TOKEN=

# ---- 本地附件与离线备份 ----
# UPLOAD_ROOT=F:/pomelo-data/uploads
# 设置后采集最近一次成功备份时间；路径应与备份命令使用的设置一致。
# BACKUP_STATUS_FILE=F:/pomelo-backups/backup-status.json
