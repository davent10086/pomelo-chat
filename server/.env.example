# pomelo-chat 服务端环境变量配置
# 复制本文件为 .env 并填写真实值（.env 不要提交到仓库）

# ---- JWT ----
# JWT 签名密钥（必填，建议使用随机长字符串）
JWT_SECRET=your-super-secret-jwt-key-change-me

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pomelo-chat

# ---- Redis ----
# ioredis 默认连接 127.0.0.1:6379，如需自定义请设置 REDIS_URL
# REDIS_URL=redis://127.0.0.1:6379

# ---- CORS ----
# 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- AI 助手（DeepSeek）----
# DeepSeek API Key（H4/M10 已移至后端，前端不再暴露）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 服务端口 ----
PORT=3000
