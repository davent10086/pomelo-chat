# pomelo-chat 服务端环境变量配置
# 复制本文件为 .env 并填写真实值（.env 不要提交到仓库）

# ---- JWT ----
# JWT 签名密钥（必填，建议使用随机长字符串）
JWT_SECRET=your-super-secret-jwt-key-change-me

# ---- 测试隔离 ----
# 数据库名称必须包含独立的 test 段；禁止填写开发或生产库。
# test:full:server / test:full:browser 会用这里的连接权限创建自己的临时库并自动删除。
# DATABASE_URL_TEST=mysql://root:password@127.0.0.1:3306/pomelo_chat_test
# REDIS_URL_TEST=redis://127.0.0.1:6379/15

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pomelo-chat
# 也可使用 MySQL URL（优先于 DB_*）；支持 ssl-mode=REQUIRED/VERIFY_IDENTITY 和 connection_limit=1..100。
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/pomelo-chat
# 多副本上线时先运行迁移，再设置 false；迁移器本身也持有 MySQL 全局锁。
DB_AUTO_MIGRATE=true
# 所有数据库会话和应用日历使用 Asia/Shanghai (+08:00)，不依赖容器默认时区。

# ---- Redis ----
# ioredis 默认连接 127.0.0.1:6379，如需自定义请设置 REDIS_URL
# REDIS_URL=redis://127.0.0.1:6379

# ---- CORS ----
# 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,pomelo://app

# ---- AI 助手（千问，阿里云百炼北京地域）----
# 仅在服务端配置；其他地域使用对应的兼容接口地址和密钥
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
# 兼容旧 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL，AI_* 优先

# ---- 服务端口 ----
PORT=3000
# 只信任实际反向代理的地址或网段；直接暴露服务时保持空。
TRUST_PROXY=
AUTH_IP_RATE_LIMIT_MAX=30
AUTH_ACCOUNT_RATE_LIMIT_MAX=10

# ---- 附件目录 ----
# 默认 server/uploads，与启动时工作目录无关；相对路径以 server 目录为基准。
# 多实例部署请配置同一共享目录，或接入对象存储。已有附件需使用原存储目录。
UPLOAD_ROOT=uploads
MAX_UPLOAD_CHUNKS=100
MAX_UPLOAD_SIZE_BYTES=104857600
MAX_USER_UPLOAD_BYTES=524288000
MAX_USER_UPLOAD_SESSIONS=20

# ---- 消息入口保护：平均每秒额度 / 短突发容量 ----
MESSAGE_USER_RATE=5
MESSAGE_USER_BURST=10
MESSAGE_PRIVATE_RATE=10
MESSAGE_PRIVATE_BURST=20
MESSAGE_GROUP_RATE=20
MESSAGE_GROUP_BURST=20
MESSAGE_GLOBAL_RATE=150
MESSAGE_GLOBAL_BURST=100

# 单进程排队上限（包含执行中的任务）
MESSAGE_ROOM_QUEUE_MAX=32
MESSAGE_WRITE_QUEUE_MAX=256
# Outbox 每两秒采样一次；保护阈值为软门槛，并非数据库硬容量
MESSAGE_OUTBOX_MAX_PENDING=500
MESSAGE_OUTBOX_ROOM_MAX_PENDING=40
MESSAGE_OUTBOX_MAX_AGE_SECONDS=3
# 单次投递最长执行时间；超时取消后按原有退避重试，关闭时最多等待 5 秒。
MESSAGE_OUTBOX_DELIVERY_TIMEOUT_MS=45000
# 达到上限后暂停该消息并阻塞本房间后续投递；修复原因后手动 outbox:retry，不丢弃消息。
MESSAGE_OUTBOX_MAX_ATTEMPTS=30
MESSAGE_OUTBOX_RETENTION_DAYS=7
# AI 单次模型输出上限；总请求期限为 120 秒。
AI_MAX_OUTPUT_TOKENS=4096

# 留空关闭指标访问；启用后 /internal/metrics 要求 Authorization: Bearer <token>
METRICS_TOKEN=
